# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Generated media
#
# `prebuild` runs scripts/build-images.ts, which regenerates everything below
# from assets/source/ on every build, including in CI. Committing it would put
# ~4MB of derivatives in the history for no benefit.
# ---------------------------------------------------------------------------
/public/media/
/public/og/
/public/icon-*.png
/public/apple-touch-icon.png

# NOT ignored, and deliberately so:
#
#   assets/source/            the source images — build-images reads these
#   public/video/             build-video.ts needs the client's raw clips from
#                             ../media plus ffmpeg, neither of which exists in
#                             CI, so the encoded output is committed
#   src/generated/*.json      image manifest is regenerated by prebuild, but
#                             the video manifest cannot be, so both are tracked
#                             to keep a checkout type-checkable before a build

# Local screenshot output from scripts/shoot.ts
/shots/
